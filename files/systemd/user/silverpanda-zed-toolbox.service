[Unit]
Description=Prepare the "zed" toolbox for Zed's C/C++ language server
Documentation=https://github.com/wiertless/silverpanda#zed-cc-toolbox
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/libexec/silverpanda/zed-toolbox-setup
TimeoutStartSec=15min

[Install]
WantedBy=default.target
