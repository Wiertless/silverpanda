# Framework Laptop 13 (AMD) Goodix fingerprint reader. It ships with USB
# persist off and runtime autosuspend on; keep it powered and keep its USB
# session across suspend so the lock screen can reach it right after resume.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="27c6", ATTR{idProduct}=="609c", ATTR{power/persist}="1", ATTR{power/control}="on"
